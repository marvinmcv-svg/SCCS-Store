# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/sccs_store"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Object storage (S3-compatible: Railway Buckets, R2, Supabase, AWS) ──
# Without these, uploads go to ./.data/uploads (dev only; not persistent on Vercel).
S3_ENDPOINT="https://t3.storageapi.dev"
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="1"       # only for MinIO-style endpoints
# S3_PUBLIC_URL=""              # if the bucket is public, serve images directly

# ── Notifications (optional; without them emails log to console and
#    WhatsApp uses one-tap click-to-chat links in the admin) ──
RESEND_API_KEY=""
EMAIL_FROM="SCCS Store <tienda@sccs.edu.bo>"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_MODE="1"

# ── Ops (optional) ──
CRON_SECRET=""                  # protects /api/cron/expire (Vercel Cron sends it automatically)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
